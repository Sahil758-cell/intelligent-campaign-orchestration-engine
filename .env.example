# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# Priority 1: Cerebras free-tier (Llama 3.1-8b) — https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Priority 2: Groq free-tier (Llama 3.1-8b-instant) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Priority 3: Anthropic Claude (claude-sonnet-4-6) — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
